{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/sdlc/task-design-validation/v1",
  "title": "SDLC Task Design Validation Result v1",
  "description": "A deterministic validation report for one task-design envelope, including envelope/schema checks, policy selection, CUE enforcement, derived policy obligations, instructive findings, and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "phases", "findings", "evidence"],
  "properties": {
    "schema": {
      "const": "https://schemas.handschuh.dev/sdlc/task-design-validation/v1",
      "description": "The versioned validation-result contract identifier.",
      "examples": ["https://schemas.handschuh.dev/sdlc/task-design-validation/v1"]
    },
    "status": {
      "type": "string",
      "enum": ["passed", "blocked", "invalid", "failed"],
      "description": "Overall validation status: passed means all checks passed; blocked means policy obligations are unsatisfied; invalid means the task contract or selection is invalid; failed means validation could not be executed.",
      "examples": ["passed", "blocked", "invalid", "failed"]
    },
    "task": {
      "$ref": "#/$defs/TaskIdentity",
      "description": "The task envelope selected by taskUid.",
      "examples": [{"taskUid": "WI-0003-10000000", "workItemId": "WI-0003", "path": ".docs/work-items/WI-0003/steps/WI-0003-10000000.yaml", "taskType": "design", "taskSchema": "https://schemas.handschuh.dev/sdlc/task-design/v1"}]
    },
    "policy": {
      "$ref": "#/$defs/PolicySelection",
      "description": "The policy selected from the host registry for this task.",
      "examples": [{"id": "system-design", "version": "1", "scope": "system", "profile": "implementable", "facets": ["structure"]}]
    },
    "phases": {
      "$ref": "#/$defs/Phases",
      "description": "Results for each deterministic validation phase.",
      "examples": [{"resolution": {"valid": true}, "envelope": {"valid": true}, "taskDesign": {"valid": true}, "policySelection": {"valid": true}, "cueDerivation": {"valid": true, "expectedOutputs": 12, "expectedVerifications": 13}, "cueApplication": {"valid": true}}]
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/Finding"},
      "description": "Stable, instructive validation findings sorted deterministically.",
      "examples": [[]]
    },
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/Evidence"},
      "description": "Static evidence describing the task file and validation commands used.",
      "examples": [[]]
    }
  },
  "$defs": {
    "TaskIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskUid", "workItemId", "path"],
      "description": "Identity and source location of the validated task envelope.",
      "properties": {
        "taskUid": {"type": "string", "pattern": "^[A-Z]{1,10}-[0-9]+-[0-9]{8}$", "description": "Validated task UID.", "examples": ["WI-0003-10000000"]},
        "workItemId": {"type": "string", "pattern": "^[A-Z]{1,10}-[0-9]+$", "description": "Parent work-item identity.", "examples": ["WI-0003"]},
        "path": {"type": "string", "minLength": 1, "description": "Repository-relative or absolute path of the selected task document.", "examples": [".docs/work-items/WI-0003/steps/WI-0003-10000000.yaml"]},
        "taskType": {"type": "string", "description": "Envelope task type when available.", "examples": ["design"]},
        "taskSchema": {"type": "string", "format": "uri", "description": "Selected task contract URI when available.", "examples": ["https://schemas.handschuh.dev/sdlc/task-design/v1"]}
      }
      ,"examples": [{"taskUid": "WI-0003-10000000", "workItemId": "WI-0003", "path": ".docs/work-items/WI-0003/steps/WI-0003-10000000.yaml"}]
    },
    "PolicySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "scope", "profile", "facets"],
      "description": "Effective task-design policy selection.",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "description": "Policy registry identity.", "examples": ["system-design"]},
        "version": {"type": "string", "pattern": "^[1-9][0-9]*(?:\\.[0-9]+){0,2}$", "description": "Immutable policy version.", "examples": ["1"]},
        "scope": {"type": "string", "enum": ["system", "subsystem", "component", "realization"], "description": "Structural design scope selected by intent.", "examples": ["system"]},
        "profile": {"type": "string", "enum": ["coherent", "decomposable", "implementable", "concrete"], "description": "Validation profile selected by intent.", "examples": ["implementable"]},
        "facets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["structure", "behavior", "contract", "deployment", "policy"]}, "description": "Facets selected by intent.", "examples": [["structure"]]}
      }
      ,"examples": [{"id": "system-design", "version": "1", "scope": "system", "profile": "implementable", "facets": ["structure"]}]
    },
    "Phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "description": "One validation phase result.",
      "properties": {
        "valid": {"type": "boolean", "description": "Whether this phase passed.", "examples": [true, false]},
        "errors": {"type": "array", "items": {"$ref": "#/$defs/Finding"}, "description": "Findings produced by this phase.", "examples": [[]]},
        "expectedOutputs": {"type": "integer", "minimum": 0, "description": "Number of policy-derived output obligations.", "examples": [12]},
        "expectedVerifications": {"type": "integer", "minimum": 0, "description": "Number of policy-derived verification obligations.", "examples": [13]}
      }
      ,"examples": [{"valid": true}]
    },
    "Phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution", "envelope", "taskDesign", "policySelection", "cueDerivation", "cueApplication"],
      "description": "Named phases of task-design validation.",
      "properties": {
        "resolution": {"$ref": "#/$defs/Phase", "description": "Task UID resolution phase.", "examples": [{"valid": true}]},
        "envelope": {"$ref": "#/$defs/Phase", "description": "Task-envelope schema validation phase.", "examples": [{"valid": true}]},
        "taskDesign": {"$ref": "#/$defs/Phase", "description": "Task-design payload schema validation phase.", "examples": [{"valid": true}]},
        "policySelection": {"$ref": "#/$defs/Phase", "description": "Policy registry selection phase.", "examples": [{"valid": true}]},
        "cueDerivation": {"$ref": "#/$defs/Phase", "description": "CUE policy and obligation derivation phase.", "examples": [{"valid": true, "expectedOutputs": 12, "expectedVerifications": 13}]},
        "cueApplication": {"$ref": "#/$defs/Phase", "description": "CUE policy application enforcement phase.", "examples": [{"valid": true}]}
      }
      ,"examples": [{"resolution": {"valid": true}, "envelope": {"valid": true}, "taskDesign": {"valid": true}, "policySelection": {"valid": true}, "cueDerivation": {"valid": true}, "cueApplication": {"valid": true}}]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "kind", "message"],
      "description": "One actionable validation finding.",
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$", "description": "Stable machine-readable finding code.", "examples": ["POLICY_OUTPUT_MISSING"]},
        "severity": {"type": "string", "enum": ["error", "warning", "blocking"], "description": "Finding severity.", "examples": ["blocking"]},
        "kind": {"type": "string", "enum": ["contract", "operational", "policy"], "description": "Finding category.", "examples": ["policy"]},
        "message": {"type": "string", "minLength": 1, "description": "Human-readable diagnostic.", "examples": ["Missing output for rule requirement-allocation and source REF-001."]},
        "path": {"type": "string", "minLength": 1, "description": "JSON/CUE path associated with the finding.", "examples": ["/result/outputs"]},
        "source": {"type": "string", "minLength": 1, "description": "Source file or command output associated with the finding.", "examples": [".docs/work-items/WI-0003/steps/WI-0003-10000000.yaml"]},
        "remediation": {"type": "string", "minLength": 1, "description": "Instruction for correcting the finding.", "examples": ["Add an output with category requirement-allocation and sourceRefs including REF-001."]}
      }
      ,"examples": [{"code": "POLICY_OUTPUT_MISSING", "severity": "blocking", "kind": "policy", "message": "Missing output for a policy rule."}]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "claim"],
      "description": "Evidence record for the validation run.",
      "properties": {
        "kind": {"type": "string", "enum": ["file", "command"], "description": "Evidence source kind.", "examples": ["file", "command"]},
        "source": {"type": "string", "minLength": 1, "description": "File path or command used.", "examples": ["cue vet -c=false -d #SystemDesignApplication ..."]},
        "claim": {"type": "string", "minLength": 1, "description": "What the evidence establishes.", "examples": ["The selected task envelope was loaded and validated."]}
      }
      ,"examples": [{"kind": "file", "source": "task.yaml", "claim": "Loaded the selected task envelope."}]
    }
  },
  "examples": [
    {
      "schema": "https://schemas.handschuh.dev/sdlc/task-design-validation/v1",
      "status": "passed",
      "task": {"taskUid": "WI-0003-10000000", "workItemId": "WI-0003", "path": ".docs/work-items/WI-0003/steps/WI-0003-10000000.yaml", "taskType": "design", "taskSchema": "https://schemas.handschuh.dev/sdlc/task-design/v1"},
      "policy": {"id": "system-design", "version": "1", "scope": "system", "profile": "implementable", "facets": ["structure"]},
      "phases": {"resolution": {"valid": true}, "envelope": {"valid": true}, "taskDesign": {"valid": true}, "policySelection": {"valid": true}, "cueDerivation": {"valid": true, "expectedOutputs": 12, "expectedVerifications": 13}, "cueApplication": {"valid": true}},
      "findings": [],
      "evidence": []
    }
  ]
}