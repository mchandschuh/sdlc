{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/sdlc/stat/v1",
  "title": "SDLC Stat v1",
  "description": "Stable JSON response envelope for read-only inspection of one Git-tracked repository file, regardless of the file's object type.",
  "$comment": "The stat command reports repository-relative identity, Git tracking state, a normalized file object kind, and bounded filesystem metadata. It does not interpret domain-specific file contents or authorize mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repositoryPath",
    "fullPath",
    "tracked",
    "objectKind",
    "ref",
    "objectType",
    "objectSchemaPath",
    "stat"
  ],
  "properties": {
    "schema": {
      "anyOf": [
        {
          "const": "sdlc/stat/v1"
        },
        {
          "const": "https://schemas.handschuh.dev/sdlc/stat/v1"
        }
      ],
      "description": "The stable response contract identifier. Runtime output uses sdlc/stat/v1; the canonical persisted schema URI is also accepted for schema-aware consumers.",
      "examples": [
        "https://schemas.handschuh.dev/sdlc/stat/v1"
      ]
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "description": "The normalized repository-relative path resolved for the stat operation.",
      "examples": [
        "README.md"
      ]
    },
    "fullPath": {
      "type": "string",
      "pattern": "^/.+$",
      "description": "The absolute filesystem path resolved for the stat operation.",
      "examples": [
        "/home/michael/src/github/sdlc/README.md"
      ]
    },
    "tracked": {
      "const": true,
      "description": "Whether the requested path is tracked by the repository's Git index.",
      "examples": [
        true
      ]
    },
    "objectKind": {
      "const": "file",
      "description": "The normalized object category for a stat response. File contents may be any supported object type, but the response envelope remains stable.",
      "examples": [
        "file"
      ]
    },
    "ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{1,10}-[0-9]+#[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*)*#[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[A-Za-z][A-Za-z0-9._:-]*$",
      "description": "The canonical work-item-local reference for a recognized SDLC object, or null when the tracked file is not a recognized object.",
      "examples": [
        null,
        "WI-0008#work-item.json#work-item/WI-0008",
        "WI-0007#steps/WI-0007-10000000-implementation.yaml#task/WI-0007-10000000"
      ]
    },
    "objectType": {
      "enum": [
        "file",
        "work-item",
        "task"
      ],
      "description": "The recognized SDLC object type, or file for an ordinary tracked file.",
      "examples": [
        "file",
        "work-item",
        "task"
      ]
    },
    "objectSchemaPath": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
      "description": "Repository-relative path to the persisted schema for a recognized object, or null for an ordinary tracked file.",
      "examples": [
        null,
        "schemas/work-item/v2/work-item.schema.json",
        "schemas/sdlc-task-envelope/v1/sdlc-task-envelope.schema.json"
      ]
    },
    "stat": {
      "$ref": "#/$defs/FileStat",
      "description": "Bounded filesystem metadata for the tracked file.",
      "examples": [
        {
          "size": 1024,
          "mtime": "2026-11-18T00:00:00.000Z",
          "mode": 33188
        }
      ]
    }
  },
  "$defs": {
    "FileStat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "mtime",
        "mode"
      ],
      "description": "Filesystem metadata intentionally limited to stable numeric size/mode and an ISO timestamp.",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes.",
          "examples": [
            1024
          ]
        },
        "mtime": {
          "type": "string",
          "format": "date-time",
          "description": "Filesystem modification timestamp in ISO 8601 format.",
          "examples": [
            "2026-11-18T00:00:00.000Z"
          ]
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "description": "Numeric filesystem mode reported by the local runtime.",
          "examples": [
            33188
          ]
        }
      },
      "examples": [
        {
          "size": 1024,
          "mtime": "2026-11-18T00:00:00.000Z",
          "mode": 33188
        }
      ]
    }
  },
  "examples": [
    {
      "schema": "sdlc/stat/v1",
      "repositoryPath": "README.md",
      "fullPath": "/home/michael/src/github/sdlc/README.md",
      "tracked": true,
      "objectKind": "file",
      "ref": null,
      "objectType": "file",
      "objectSchemaPath": null,
      "stat": {
        "size": 1024,
        "mtime": "2026-11-18T00:00:00.000Z",
        "mode": 33188
      }
    },
    {
      "schema": "sdlc/stat/v1",
      "repositoryPath": ".docs/work-items/WI-0008/work-item.json",
      "fullPath": "/home/michael/src/github/sdlc/.docs/work-items/WI-0008/work-item.json",
      "tracked": true,
      "objectKind": "file",
      "ref": "WI-0008#work-item.json#work-item/WI-0008",
      "objectType": "work-item",
      "objectSchemaPath": "schemas/work-item/v2/work-item.schema.json",
      "stat": {
        "size": 1024,
        "mtime": "2026-11-18T00:00:00.000Z",
        "mode": 33188
      }
    },
    {
      "schema": "sdlc/stat/v1",
      "repositoryPath": ".docs/work-items/WI-0007/steps/WI-0007-10000000-implementation.yaml",
      "fullPath": "/home/michael/src/github/sdlc/.docs/work-items/WI-0007/steps/WI-0007-10000000-implementation.yaml",
      "tracked": true,
      "objectKind": "file",
      "ref": "WI-0007#steps/WI-0007-10000000-implementation.yaml#task/WI-0007-10000000",
      "objectType": "task",
      "objectSchemaPath": "schemas/sdlc-task-envelope/v1/sdlc-task-envelope.schema.json",
      "stat": {
        "size": 1024,
        "mtime": "2026-11-18T00:00:00.000Z",
        "mode": 33188
      }
    }
  ]
}