{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/sdlc/work-item-validation/v1",
  "title": "SDLC Work Item Validation v1",
  "description": "Closed JSON response envelope for validating a work-item record and every task object declared below its stepsPath.",
  "$comment": "Validation is read-only. The command validates work-item.json with work-item/v2, each task envelope with task-envelope/v1, and each task intent/result with the selected task-specific contract. It does not approve, execute, mutate, or release the work item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workItemId",
    "valid",
    "objectCount",
    "validObjectCount",
    "invalidObjectCount",
    "objects",
    "findings",
    "scope",
    "referenceCount",
    "validReferenceCount",
    "invalidReferenceCount",
    "unresolvedReferenceCount",
    "references"
  ],
  "properties": {
    "schema": {
      "const": "https://schemas.handschuh.dev/sdlc/work-item-validation/v1",
      "description": "The canonical persisted response schema identifier.",
      "examples": [
        "https://schemas.handschuh.dev/sdlc/work-item-validation/v1"
      ]
    },
    "workItemId": {
      "type": "string",
      "pattern": "^[A-Z]{1,10}-[0-9]+$",
      "description": "The work item whose complete object tree was validated.",
      "examples": [
        "WI-0008"
      ]
    },
    "valid": {
      "type": "boolean",
      "description": "Whether every discovered work-item and task object validated successfully.",
      "examples": [
        true,
        false
      ]
    },
    "objectCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of validated objects, including work-item.json and discovered task envelopes.",
      "examples": [
        3
      ]
    },
    "validObjectCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of objects that passed all applicable schema validations.",
      "examples": [
        3,
        2
      ]
    },
    "invalidObjectCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of objects with one or more validation findings.",
      "examples": [
        0,
        1
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Per-object validation outcomes in deterministic artifact order.",
      "items": {
        "$ref": "#/$defs/ObjectValidation",
        "description": "One validated work-item or task object.",
        "examples": [
          {
            "path": ".docs/work-items/WI-0008/work-item.json",
            "schema": "sdlc/stat/v1",
            "repositoryPath": ".docs/work-items/WI-0008/work-item.json",
            "tracked": true,
            "objectKind": "file",
            "ref": "WI-0008#work-item.json#work-item/WI-0008",
            "objectType": "work-item",
            "objectSchemaPath": "schemas/work-item/v2/work-item.schema.json",
            "valid": true,
            "findings": []
          }
        ]
      },
      "examples": [
        [
          {
            "schema": "sdlc/stat/v1",
            "repositoryPath": ".docs/work-items/WI-0008/work-item.json",
            "fullPath": "/home/michael/src/github/sdlc/.docs/work-items/WI-0008/work-item.json",
            "tracked": true,
            "objectKind": "file",
            "ref": "WI-0008#work-item.json#work-item/WI-0008",
            "path": ".docs/work-items/WI-0008/work-item.json",
            "objectSchemaPath": "schemas/work-item/v2/work-item.schema.json",
            "objectType": "work-item",
            "valid": true,
            "findings": []
          }
        ]
      ]
    },
    "findings": {
      "type": "array",
      "description": "Flattened actionable validation findings across all objects.",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "One validation finding.",
        "examples": [
          "FAIL task envelope: schema mismatch"
        ]
      },
      "examples": [
        [],
        [
          "FAIL task envelope: schema mismatch"
        ]
      ]
    },
    "scope": {
      "enum": [
        "work-item",
        "task"
      ],
      "description": "Validation scope selected by the command.",
      "examples": [
        "work-item",
        "task"
      ]
    },
    "referenceCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total references discovered in selected documents.",
      "examples": [
        12
      ]
    },
    "validReferenceCount": {
      "type": "integer",
      "minimum": 0,
      "description": "References with valid syntax and local target resolution.",
      "examples": [
        10
      ]
    },
    "invalidReferenceCount": {
      "type": "integer",
      "minimum": 0,
      "description": "References rejected by syntax validation.",
      "examples": [
        1
      ]
    },
    "unresolvedReferenceCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Syntactically valid references whose target or context failed resolution.",
      "examples": [
        1
      ]
    },
    "references": {
      "type": "array",
      "description": "All per-reference validation outcomes.",
      "items": {
        "$ref": "#/$defs/ReferenceFinding"
      },
      "examples": [
        []
      ]
    }
  },
  "$defs": {
    "ObjectValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "repositoryPath",
        "fullPath",
        "tracked",
        "objectKind",
        "ref",
        "objectType",
        "objectSchemaPath",
        "valid",
        "findings"
      ],
      "description": "Validation result for one repository object.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative object path, or a finding path for an unreadable task object.",
          "examples": [
            ".docs/work-items/WI-0008/work-item.json"
          ]
        },
        "schema": {
          "anyOf": [
            {
              "const": "sdlc/stat/v1"
            },
            {
              "const": "https://schemas.handschuh.dev/sdlc/stat/v1"
            }
          ],
          "description": "The stat response contract identifier used for the object identity fields.",
          "examples": [
            "https://schemas.handschuh.dev/sdlc/stat/v1"
          ]
        },
        "repositoryPath": {
          "type": "string",
          "minLength": 1,
          "description": "The normalized repository-relative object path.",
          "examples": [
            ".docs/work-items/WI-0008/work-item.json"
          ]
        },
        "fullPath": {
          "type": "string",
          "pattern": "^/.+$",
          "description": "The absolute filesystem path resolved for this validated object.",
          "examples": [
            "/home/michael/src/github/sdlc/.docs/work-items/WI-0008/work-item.json"
          ]
        },
        "tracked": {
          "type": "boolean",
          "description": "Whether the object path is tracked by the repository Git index.",
          "examples": [
            true
          ]
        },
        "objectKind": {
          "const": "file",
          "description": "The stat-compatible normalized object category.",
          "examples": [
            "file"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "The canonical object reference, or null when no reference could be constructed.",
          "examples": [
            "WI-0008#work-item.json#work-item/WI-0008",
            "WI-0008#steps/WI-0008-10000000-implementation.yaml#task/WI-0008-10000000",
            null
          ]
        },
        "objectType": {
          "enum": [
            "file",
            "work-item",
            "task"
          ],
          "description": "The validated object category.",
          "examples": [
            "work-item",
            "task"
          ]
        },
        "objectSchemaPath": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
          "description": "Repository-relative path to the selected object schema, or null when none applies.",
          "examples": [
            "schemas/work-item/v2/work-item.schema.json",
            "schemas/sdlc-task-envelope/v1/sdlc-task-envelope.schema.json",
            null
          ]
        },
        "taskUid": {
          "type": "string",
          "pattern": "^[A-Z]{1,10}-[0-9]+-[0-9]{8}$",
          "description": "The task UID when objectType is task.",
          "examples": [
            "WI-0008-10000000"
          ]
        },
        "valid": {
          "type": "boolean",
          "description": "Whether this object passed its applicable schema validations.",
          "examples": [
            true,
            false
          ]
        },
        "findings": {
          "type": "array",
          "description": "Validation findings for this object.",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "One object validation finding.",
            "examples": [
              "Schema validation failed"
            ]
          },
          "examples": [
            []
          ]
        },
        "schemaFindings": {
          "type": "array",
          "description": "Schema-only findings for this object.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "examples": [
            []
          ]
        },
        "referenceFindings": {
          "type": "array",
          "description": "Reference outcomes discovered for this object, including when schema validation failed.",
          "items": {
            "$ref": "#/$defs/ReferenceFinding"
          },
          "examples": [
            []
          ]
        },
        "remediation": {
          "type": "array",
          "description": "Actionable remediation suggestions for this object.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "examples": [
            []
          ]
        }
      },
      "examples": [
        {
          "path": ".docs/work-items/WI-0008/work-item.json",
          "schema": "sdlc/stat/v1",
          "repositoryPath": ".docs/work-items/WI-0008/work-item.json",
          "fullPath": "/home/michael/src/github/sdlc/.docs/work-items/WI-0008/work-item.json",
          "tracked": true,
          "objectKind": "file",
          "ref": "WI-0008#work-item.json#work-item/WI-0008",
          "objectType": "work-item",
          "objectSchemaPath": "schemas/work-item/v2/work-item.schema.json",
          "valid": true,
          "findings": []
        }
      ]
    },
    "ReferenceFinding": {
      "type": "object",
      "description": "One reference validation result with coding-agent remediation context.",
      "additionalProperties": false,
      "required": [
        "path",
        "value",
        "category",
        "syntaxValid",
        "resolved",
        "reason",
        "remediation"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "JSON/YAML-style location of the reference value.",
          "examples": [
            "$.task.intent.inputs[0].ref"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Reference value that was validated.",
          "examples": [
            "WI-0001-10000000#result/R-001"
          ]
        },
        "category": {
          "enum": [
            "syntax",
            "target",
            "context",
            "parse"
          ],
          "description": "Reference validation category.",
          "examples": [
            "target"
          ]
        },
        "syntaxValid": {
          "type": "boolean",
          "description": "Whether the reference matched a registered syntax schema.",
          "examples": [
            true
          ]
        },
        "resolved": {
          "type": "boolean",
          "description": "Whether the reference resolved to a local target.",
          "examples": [
            false
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Observed validation reason.",
          "examples": [
            "Selector not found in the selected task."
          ]
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "description": "Actionable remediation guidance.",
          "examples": [
            "Update the reference to an existing target."
          ]
        }
      },
      "examples": [
        {
          "path": "$.task.intent.inputs[0].ref",
          "value": "WI-0001-10000000#result/R-001",
          "category": "target",
          "syntaxValid": true,
          "resolved": false,
          "reason": "Selector not found in the selected task.",
          "remediation": "Update the reference to an existing target."
        }
      ]
    }
  },
  "examples": [
    {
      "schema": "https://schemas.handschuh.dev/sdlc/work-item-validation/v1",
      "workItemId": "WI-0008",
      "valid": true,
      "objectCount": 3,
      "validObjectCount": 3,
      "invalidObjectCount": 0,
      "objects": [
        {
          "path": ".docs/work-items/WI-0008/work-item.json",
          "schema": "sdlc/stat/v1",
          "repositoryPath": ".docs/work-items/WI-0008/work-item.json",
          "fullPath": "/home/michael/src/github/sdlc/.docs/work-items/WI-0008/work-item.json",
          "tracked": true,
          "objectKind": "file",
          "ref": "WI-0008#work-item.json#work-item/WI-0008",
          "objectType": "work-item",
          "objectSchemaPath": "schemas/work-item/v2/work-item.schema.json",
          "valid": true,
          "findings": []
        }
      ],
      "findings": []
    }
  ]
}
