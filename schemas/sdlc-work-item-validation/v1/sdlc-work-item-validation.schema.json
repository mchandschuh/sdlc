{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/sdlc/work-item-validation/v1",
  "title": "SDLC Work Item Validation v1",
  "description": "Closed JSON response envelope for validating a work-item record and every task object declared below its stepsPath.",
  "$comment": "Validation is read-only. The command validates work-item.json with work-item/v2, each task envelope with task-envelope/v1, and each task intent/result with the selected task-specific contract. It does not approve, execute, mutate, or release the work item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workItemId",
    "valid",
    "objectCount",
    "validObjectCount",
    "invalidObjectCount",
    "objects",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "https://schemas.handschuh.dev/sdlc/work-item-validation/v1",
      "description": "The canonical persisted response schema identifier.",
      "examples": [
        "https://schemas.handschuh.dev/sdlc/work-item-validation/v1"
      ]
    },
    "workItemId": {
      "type": "string",
      "pattern": "^[A-Z]{1,10}-[0-9]+$",
      "description": "The work item whose complete object tree was validated.",
      "examples": [
        "WI-0008"
      ]
    },
    "valid": {
      "type": "boolean",
      "description": "Whether every discovered work-item and task object validated successfully.",
      "examples": [
        true,
        false
      ]
    },
    "objectCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of validated objects, including work-item.json and discovered task envelopes.",
      "examples": [
        3
      ]
    },
    "validObjectCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of objects that passed all applicable schema validations.",
      "examples": [
        3,
        2
      ]
    },
    "invalidObjectCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of objects with one or more validation findings.",
      "examples": [
        0,
        1
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Per-object validation outcomes in deterministic artifact order.",
      "items": {
        "$ref": "#/$defs/ObjectValidation",
        "description": "One validated work-item or task object.",
        "examples": [
          {
            "path": ".docs/work-items/WI-0008/work-item.json",
            "objectType": "work-item",
            "valid": true,
            "findings": []
          }
        ]
      },
      "examples": [
        [
          {
            "path": ".docs/work-items/WI-0008/work-item.json",
            "objectType": "work-item",
            "valid": true,
            "findings": []
          }
        ]
      ]
    },
    "findings": {
      "type": "array",
      "description": "Flattened actionable validation findings across all objects.",
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "One validation finding.",
        "examples": [
          "FAIL task envelope: schema mismatch"
        ]
      },
      "examples": [
        [],
        [
          "FAIL task envelope: schema mismatch"
        ]
      ]
    }
  },
  "$defs": {
    "ObjectValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "objectType",
        "valid",
        "findings"
      ],
      "description": "Validation result for one repository object.",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative object path, or a finding path for an unreadable task object.",
          "examples": [
            ".docs/work-items/WI-0008/work-item.json"
          ]
        },
        "objectType": {
          "enum": [
            "work-item",
            "task"
          ],
          "description": "The validated object category.",
          "examples": [
            "work-item",
            "task"
          ]
        },
        "taskUid": {
          "type": "string",
          "pattern": "^[A-Z]{1,10}-[0-9]+-[0-9]{8}$",
          "description": "The task UID when objectType is task.",
          "examples": [
            "WI-0008-10000000"
          ]
        },
        "valid": {
          "type": "boolean",
          "description": "Whether this object passed its applicable schema validations.",
          "examples": [
            true,
            false
          ]
        },
        "findings": {
          "type": "array",
          "description": "Validation findings for this object.",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "One object validation finding.",
            "examples": [
              "Schema validation failed"
            ]
          },
          "examples": [
            []
          ]
        }
      },
      "examples": [
        {
          "path": ".docs/work-items/WI-0008/work-item.json",
          "objectType": "work-item",
          "valid": true,
          "findings": []
        }
      ]
    }
  },
  "examples": [
    {
      "schema": "https://schemas.handschuh.dev/sdlc/work-item-validation/v1",
      "workItemId": "WI-0008",
      "valid": true,
      "objectCount": 3,
      "validObjectCount": 3,
      "invalidObjectCount": 0,
      "objects": [
        {
          "path": ".docs/work-items/WI-0008/work-item.json",
          "objectType": "work-item",
          "valid": true,
          "findings": []
        }
      ],
      "findings": []
    }
  ]
}