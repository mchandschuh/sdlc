{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/sdlc/cli-task-next/v1",
  "title": "SDLC CLI Task Next v1",
  "description": "Closed JSON response envelope for dependency-aware read-only task selection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workItemId", "selection", "task", "findings"],
  "properties": {
    "schema": {"const": "https://schemas.handschuh.dev/sdlc/cli-task-next/v1"},
    "workItemId": {"type": "string", "pattern": "^[A-Z]{1,10}-[0-9]+$"},
    "selection": {"enum": ["selected", "none", "invalid"]},
    "task": {"anyOf": [{"$ref": "#/$defs/Task"}, {"type": "null"}]},
    "findings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskUid", "taskType", "processingStatus", "taskStatus", "path", "dependencies"],
      "properties": {
        "taskUid": {"type": "string", "pattern": "^[A-Z]{1,10}-[0-9]+-[0-9]{8}$"},
        "taskType": {"type": "string", "minLength": 1},
        "processingStatus": {"type": "string", "minLength": 1},
        "taskStatus": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{1,10}-[0-9]+-[0-9]{8}$"}}
      }
    }
  },
  "examples": [{"schema":"https://schemas.handschuh.dev/sdlc/cli-task-next/v1","workItemId":"WI-0038","selection":"none","task":null,"findings":[]}]
}
