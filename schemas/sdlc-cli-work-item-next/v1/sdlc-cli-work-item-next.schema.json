{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/sdlc/cli-work-item-next/v1",
  "title": "SDLC CLI Work-Item Next v1",
  "description": "Closed JSON response envelope for initial deterministic non-complete work-item selection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "selection", "workItem", "findings"],
  "properties": {
    "schema": {"const": "https://schemas.handschuh.dev/sdlc/cli-work-item-next/v1"},
    "selection": {"enum": ["selected", "none"]},
    "workItem": {"anyOf": [{"$ref": "#/$defs/WorkItem"}, {"type": "null"}]},
    "findings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "WorkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workItemId", "status", "title", "path"],
      "properties": {
        "workItemId": {"type": "string", "pattern": "^[A-Z]{1,10}-[0-9]+$"},
        "status": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    }
  },
  "examples": [{"schema":"https://schemas.handschuh.dev/sdlc/cli-work-item-next/v1","selection":"none","workItem":null,"findings":[]}]
}
