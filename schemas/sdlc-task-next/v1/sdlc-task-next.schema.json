{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.handschuh.dev/sdlc/task-next/v1",
  "title": "SDLC Task Next v1",
  "description": "Closed JSON response envelope for selecting the next task requiring host processing from one work item.",
  "$comment": "Selection is read-only. A task is eligible only when its task envelope processingStatus is unprocessed; the command does not execute, lock, or mutate the selected task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workItemId",
    "selection",
    "task"
  ],
  "properties": {
    "schema": {
      "const": "https://schemas.handschuh.dev/sdlc/task-next/v1",
      "description": "The canonical persisted response schema identifier.",
      "examples": [
        "https://schemas.handschuh.dev/sdlc/task-next/v1"
      ]
    },
    "workItemId": {
      "type": "string",
      "pattern": "^[A-Z]{1,10}-[0-9]+$",
      "description": "The selected work-item identifier.",
      "examples": [
        "WI-0008"
      ]
    },
    "selection": {
      "enum": [
        "selected",
        "none"
      ],
      "description": "Whether a task requiring processing was selected.",
      "examples": [
        "selected",
        "none"
      ]
    },
    "task": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskSummary"
        },
        {
          "type": "null"
        }
      ],
      "description": "The selected task summary, or null when no task has processingStatus unprocessed.",
      "examples": [
        {
          "taskUid": "WI-0008-10000000",
          "taskType": "implementation",
          "processingStatus": "unprocessed",
          "taskStatus": "planned",
          "path": ".docs/work-items/WI-0008/steps/WI-0008-10000000-implementation.yaml"
        },
        null
      ]
    }
  },
  "$defs": {
    "TaskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskUid",
        "taskType",
        "processingStatus",
        "taskStatus",
        "path"
      ],
      "description": "The repository-relative summary of the selected task envelope.",
      "properties": {
        "taskUid": {
          "type": "string",
          "pattern": "^[A-Z]{1,10}-[0-9]+-[0-9]{8}$",
          "description": "The selected task UID.",
          "examples": [
            "WI-0008-10000000"
          ]
        },
        "taskType": {
          "type": "string",
          "minLength": 1,
          "description": "The selected task kind.",
          "examples": [
            "implementation"
          ]
        },
        "processingStatus": {
          "const": "unprocessed",
          "description": "The eligibility status that caused this task to be selected.",
          "examples": [
            "unprocessed"
          ]
        },
        "taskStatus": {
          "type": "string",
          "minLength": 1,
          "description": "The workflow status recorded inside the selected task.",
          "examples": [
            "planned"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
          "description": "The repository-relative path to the selected task envelope.",
          "examples": [
            ".docs/work-items/WI-0008/steps/WI-0008-10000000-implementation.yaml"
          ]
        }
      },
      "examples": [
        {
          "taskUid": "WI-0008-10000000",
          "taskType": "implementation",
          "processingStatus": "unprocessed",
          "taskStatus": "planned",
          "path": ".docs/work-items/WI-0008/steps/WI-0008-10000000-implementation.yaml"
        }
      ]
    }
  },
  "examples": [
    {
      "schema": "https://schemas.handschuh.dev/sdlc/task-next/v1",
      "workItemId": "WI-0008",
      "selection": "selected",
      "task": {
        "taskUid": "WI-0008-10000000",
        "taskType": "implementation",
        "processingStatus": "unprocessed",
        "taskStatus": "planned",
        "path": ".docs/work-items/WI-0008/steps/WI-0008-10000000-implementation.yaml"
      }
    },
    {
      "schema": "https://schemas.handschuh.dev/sdlc/task-next/v1",
      "workItemId": "WI-0008",
      "selection": "none",
      "task": null
    }
  ]
}