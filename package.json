{
  "name": "sdlc",
  "version": "0.9.0",
  "description": "TypeScript Node.js CLI plumbing for sdlc, following the nodejs-cli-pattern skill conventions.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@1.22.22",
  "bin": {
    "sdlc": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/main.ts",
    "start": "node ./bin/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/yargs": "^17.0.35",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "nodejs-common": "file:../nodejs-common",
    "yaml": "^2.9.1",
    "yargs": "18.2.0"
  },
  "license": "UNLICENSED"
}
